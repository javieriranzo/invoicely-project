# Copia este archivo a .env y ajusta los valores. Nunca versiones .env (ADR-0025).

# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# PostgreSQL de desarrollo (compose.yaml)
POSTGRES_DB=invoicely
POSTGRES_USER=invoicely
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_PORT=5433

# Mailpit (correo de desarrollo)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
